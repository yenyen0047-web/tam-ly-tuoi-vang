// Prisma schema starter — cần cấu hình DATABASE_URL và migrations trước khi dùng.
// Chỉ là mô hình khởi đầu; cần review bảo mật/pháp lý trước khi lưu dữ liệu thật.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole { USER PROVIDER EDITOR ADMIN }
enum RecordStatus { DRAFT PUBLISHED ARCHIVED }
enum RequestStatus { NEW TRIAGED ASSIGNED IN_PROGRESS CLOSED }
enum AppointmentStatus { REQUESTED HELD CONFIRMED CANCELLED COMPLETED NO_SHOW }

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String?
  role         UserRole @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  plans        Plan[]
  journal      JournalEntry[]
  requests     SupportRequest[]
  appointments Appointment[] @relation("ClientAppointments")
  assignedRequests SupportRequest[] @relation("AssignedRequests")
  providerAppointments Appointment[] @relation("ProviderAppointments")
}

model Consent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  purpose       String
  policyVersion String
  grantedAt     DateTime @default(now())
  withdrawnAt   DateTime?
  createdAt     DateTime @default(now())
}

model Category {
  id      String    @id @default(uuid()) @db.Uuid
  name    String
  slug    String    @unique
  articles Article[]
}

model Article {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  title       String
  summary     String
  body        String
  status      RecordStatus @default(DRAFT)
  categoryId  String       @db.Uuid
  category    Category     @relation(fields: [categoryId], references: [id])
  authorId    String       @db.Uuid
  reviewerId  String?      @db.Uuid
  reviewedAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sources     ArticleSource[]
}

model ArticleSource {
  id          String   @id @default(uuid()) @db.Uuid
  articleId   String   @db.Uuid
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  citation    String
  url         String
  accessedAt  DateTime?
}

model AssessmentDefinition {
  id         String   @id @default(uuid()) @db.Uuid
  version    String
  title      String
  reviewedBy String?
  reviewedAt DateTime?
  publishedAt DateTime?
  questions  AssessmentQuestion[]
  results    AssessmentResult[]
  @@unique([version, title])
}

model AssessmentQuestion {
  id             String   @id @default(uuid()) @db.Uuid
  definitionId   String   @db.Uuid
  definition     AssessmentDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  domain         String
  prompt         String
  orderIndex     Int
  options        AssessmentOption[]
}

model AssessmentOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  score      Int
}

model AssessmentResult {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  definitionId String   @db.Uuid
  definition   AssessmentDefinition @relation(fields: [definitionId], references: [id])
  domainScores Json
  createdAt    DateTime @default(now())
  retentionUntil DateTime?
}

model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      String
  rationale String?
  firstStep String
  startDate DateTime?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalEntry {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId       String?
  encryptedContent String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  retentionUntil DateTime?
}

model SupportRequest {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  alias          String?
  contactEncrypted String?
  topic          String
  messageEncrypted String
  status         RequestStatus @default(NEW)
  assignedToId   String?       @db.Uuid
  assignedTo     User?         @relation("AssignedRequests", fields: [assignedToId], references: [id], onDelete: SetNull)
  consentId      String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([status, createdAt])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String?           @db.Uuid
  user            User?             @relation("ClientAppointments", fields: [userId], references: [id], onDelete: SetNull)
  providerId      String            @db.Uuid
  provider        User              @relation("ProviderAppointments", fields: [providerId], references: [id])
  startAt         DateTime
  endAt           DateTime
  modality        String
  status          AppointmentStatus @default(REQUESTED)
  contactEncrypted String?
  consentId       String            @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  @@index([providerId, startAt, status])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([actorId, createdAt])
}
